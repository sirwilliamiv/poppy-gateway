# Hosted Poppy agent (hosted/src/config.ts). Copy to hosted/.env for local runs; never commit real values.

# Port the HTTP server listens on. Cloud Run sets it. Default 8080.
PORT=8080
# OAuth issuer and the origin the gateway routes are served from (the Cloud Run URL). Required.
POPPY_ISSUER=https://poppy-agent-951611905723.us-central1.run.app
# Domain whose /.well-known/poppy.json names this issuer. Required.
POPPY_PUBLIC_DOMAIN=origin-platform-labs.netlify.app
# ES256 private signing key as a JWK JSON string (secret poppy-agent-signing-key). Optional; unset means a generated key that does not survive restarts.
POPPY_SIGNING_KEY_JWK=
# GCP project for Vertex AI. Required.
GOOGLE_CLOUD_PROJECT=cast-commerce-prod
# Vertex AI location. Default global.
GEMINI_LOCATION=global
# Gemini model id on Vertex AI. Default gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
# Resend API key for lead emails (secret poppy-agent-resend-key). Optional; unset means leads go to the logs only.
RESEND_API_KEY=
# Lead email recipient. Default billy@proedu.me.
LEAD_TO=billy@proedu.me
# Lead email sender, a Resend-verified address. Default poppy@origin-platform-labs.netlify.app.
LEAD_FROM=poppy@origin-platform-labs.netlify.app
